# ------------------------------------------------------------
# AstroVani - The Cosmic Journey
# Copy this file with: cp .env.example .env
#
# This milestone assumes the Agora project has Primary Certificate
# DISABLED. RTC joins use App ID authentication with token=null.
# Astrology remains mocked for now.
# ------------------------------------------------------------

# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
MOCK_MODE=true

# Agora RTC / Conversational AI
# No AGORA_APP_CERTIFICATE is required while Primary Certificate is disabled.
AGORA_APP_ID=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_CONVO_AI_BASE_URL=https://api.agora.io/api/conversational-ai-agent/v2/projects
AGORA_AGENT_UID=10000
AGORA_AVATAR_UID=10001
# Leave empty when Primary Certificate is disabled. If token auth is enabled later, provide the avatar RTC token here.
AGORA_AVATAR_TOKEN=
AGORA_AGENT_IDLE_TIMEOUT_SECONDS=120
AGORA_ASR_LANGUAGE_HINTS=en,hi,ta,te,mr,kn
AGORA_AGENT_GREETING=Namaste. Welcome to AstroVani, The Cosmic Journey. Together we can explore your birth sky, Kundli, palm, and life timeline through a live visual journey. To begin, tell me your name in any language.
# Keep false so the opening greeting is not cut off by early user speech.
AGORA_GREETING_INTERRUPTIBLE=false
# Legacy recovery switch. Keep false: the opening greeting is sent natively in llm.greeting_message.
AGORA_FORCE_GREETING_VIA_SPEAK=false
# Allow Jyotishi to publish small whitelisted JSON UI signals over the Agora data stream.
AGORA_ENABLE_UI_TOOLS=true

# OpenAI LLM used by Agora Conversational AI
# The same key/model is also used by the backend to extract structured birth details from live transcript turns.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_LLM_URL=https://api.openai.com/v1/chat/completions

# Anam Avatar - enabled automatically when both values are set.
# Agora sends avatar_id to Anam and the avatar joins the same RTC channel using AGORA_AVATAR_UID.
ANAM_API_KEY=
ANAM_AVATAR_ID=960f614f-ea88-47c3-9883-f02094f70874
ANAM_SAMPLE_RATE=24000
ANAM_QUALITY=high
ANAM_VIDEO_ENCODING=H264
# Optional JSON merged into properties.avatar.params after the standard fields above.
# Leave empty unless your Agora/Anam documentation requires additional parameters.
ANAM_EXTRA_PARAMS_JSON=

# Murf TTS used by Agora Conversational AI
# Field names in the Agora join payload are mapped as follows:
# api_key     <- MURF_API_KEY
# base_url    <- MURF_BASE_URL
# voiceId     <- MURF_VOICE_ID
# locale      <- MURF_LOCALE
# rate        <- MURF_RATE
# pitch       <- MURF_PITCH
# model       <- MURF_MODEL
# sample_rate <- MURF_SAMPLE_RATE
MURF_API_KEY=
MURF_BASE_URL=wss://global.api.murf.ai/v1/speech/stream-input
MURF_VOICE_ID=Matthew
MURF_LOCALE=en-US
MURF_RATE=0
MURF_PITCH=0
MURF_MODEL=FALCON
MURF_SAMPLE_RATE=24000

# Optional future astrology provider / geocoder
ASTROLOGY_PROVIDER=mock
GEOCODING_API_KEY=

# Optional dedicated vision model for palm crease mapping. Defaults to OPENAI_MODEL.
OPENAI_VISION_MODEL=gpt-4o-mini
