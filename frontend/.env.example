# Frontend build-time configuration.
# Copy to .env.local for local overrides (git-ignored).

# Origin of the AstroVani backend, without a trailing slash and without /api
# (the app appends /api/... itself).
# Leave EMPTY for local development: /api requests stay relative and the Vite dev
# server proxies them to http://localhost:3000.
# Production builds use the value committed in .env.production:
#   VITE_API_BASE_URL=https://astrovani.agoraaidemo.in
# Whatever origin is set here must appear in the backend's CORS allow-list.
VITE_API_BASE_URL=
